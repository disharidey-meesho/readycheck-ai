# Super Admin credentials
SUPER_ADMIN_EMAIL=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The base URL of the application (e.g., https://your-app.run.app)
APP_URL=

# Gemini API key used to generate questions
GEMINI_API_KEY=

# Serve the pre-built front end from dist/ (development uses the Vite dev server)
NODE_ENV=production

# Request counts and timings for the builders platform (Grafana)
PROMETHEUS_METRICS=true
